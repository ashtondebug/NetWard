<Window
    x:Class="NetWard.Modern.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Padding="28,22" Spacing="12" HorizontalAlignment="Center">
                <StackPanel Spacing="2">
                    <TextBlock Text="NetWard 被控端" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="受管设备 · Modern Alpha" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="未连接" Message="等待管理端连接；本地拦截策略保持运行。" />
                <InfoBar x:Name="FallbackBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="已切换到本地拦截策略" Message="与管理端的连接已断开；本机继续按最后保存的策略执行拦截。" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="设备名称" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DeviceNameText" Grid.Column="1" Text="-" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock Grid.Row="1" Text="设备 IP" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DeviceIpText" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource BodyTextBlockStyle}" IsTextSelectionEnabled="True" />
                    </Grid>
                </Border>

                <Border x:Name="CodeCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="连接码" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ConnectionCodeText" Text="------" FontFamily="Consolas" FontSize="28" FontWeight="SemiBold" IsTextSelectionEnabled="True" />
                        <TextBlock Text="首次运行时显示；用于后续远程配对。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="14">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="连接状态" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ConnectionStateText" Grid.Column="1" Text="未连接" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Text="已运行时间" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Text="管理状态" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ManagementStateText" Grid.Row="2" Grid.Column="1" Text="等待管理端" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="UptimeText" Grid.Row="1" Grid.Column="1" Text="--:--:--" Style="{StaticResource BodyTextBlockStyle}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="PolicyText" Text="正在读取本机策略…" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />


            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
