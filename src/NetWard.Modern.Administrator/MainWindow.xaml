<Window
    x:Class="NetWard.Modern.Administrator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <NavigationView
            x:Name="Navigation"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="248"
            SelectionChanged="Navigation_SelectionChanged">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Padding="2,0">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="17" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NetWard" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="网界卫士 · Modern 管理端" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="总览" Tag="overview" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="网页访问规则" Tag="rules" Icon="Bullets" />
                <NavigationViewItem Content="限时访问" Tag="timed" Icon="Clock" />
                <NavigationViewItem Content="分类管控" Tag="categories" Icon="Filter" />
                <NavigationViewItem Content="访问日志" Tag="logs" Icon="List" />
                <NavigationViewItem Content="策略历史" Tag="history" Icon="Document" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Padding="2,8" Spacing="6">
                    <ToggleSwitch x:Name="ManagementSwitch" Header="启用管理" Toggled="ManagementSwitch_Toggled" />
                    <DropDownButton x:Name="ThemeButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE790;" FontSize="14" />
                            <TextBlock Text="主题" />
                            <TextBlock x:Name="ThemeLabel" Text="跟随系统" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="跟随系统" GroupName="Theme" IsChecked="True" Click="ThemeSystem_Click" />
                                <RadioMenuFlyoutItem x:Name="ThemeLight" Text="浅色" GroupName="Theme" Click="ThemeLight_Click" />
                                <RadioMenuFlyoutItem x:Name="ThemeDark" Text="深色" GroupName="Theme" Click="ThemeDark_Click" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <TextBlock x:Name="VersionFooter" Text="策略版本 -" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Padding="24,16,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="PageTitle" Text="总览" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="PageSubtitle" Text="本机策略与审计（WebBlocker\proxy.db）" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SaveButton" Content="保存策略" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                        <Button Click="Refresh_Click" ToolTipService.ToolTip="刷新">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="0,12,0,12" IsOpen="True" IsClosable="False" Severity="Informational" Message="就绪。编辑规则后请点击「保存策略」。" />

                <Grid Grid.Row="2">
                    <!-- 总览 -->
                    <Grid x:Name="OverviewPage" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="策略版本" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="VersionText" Text="-" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock x:Name="ModeText" Text="-" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="基础规则" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="RuleCountText" Text="-" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="白/黑名单域名" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="0" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="分类防护" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="CategoryCountText" Text="-" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock x:Name="CategoryHintText" Text="-" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="访问事件" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="EventCountText" Text="-" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="本地保留 30 天" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="最近访问事件" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ListView x:Name="RecentList" Grid.Row="1" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Padding="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Domain}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding Method}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding ResultText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding ResultBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 网页访问规则 -->
                    <Grid x:Name="RulesPage" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="访问模式" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ComboBox x:Name="ModeCombo" Width="220" HorizontalAlignment="Left" SelectionChanged="Mode_SelectionChanged">
                                    <ComboBoxItem Content="白名单（未命中即拒绝）" Tag="AllowList" />
                                    <ComboBoxItem Content="黑名单（命中即拒绝）" Tag="BlockList" />
                                </ComboBox>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DomainBox" PlaceholderText="输入域名，例如 example.com" />
                                    <CheckBox x:Name="SubdomainCheck" Grid.Column="1" Content="包含子域名" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="添加规则" Click="AddRule_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="编辑所选" Click="EditRule_Click" />
                                <Button Content="删除所选" Click="DeleteRule_Click" />
                                <Button Content="启用 / 停用" Click="ToggleRule_Click" />
                                <TextBlock x:Name="RulesHint" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="8">
                            <ListView x:Name="RulesList" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Domain}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ScopeText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding StateBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- 限时访问 -->
                    <Grid x:Name="TimedPage" Visibility="Collapsed" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="限时类别" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TimedNameBox" PlaceholderText="类别名称" />
                                    <NumberBox x:Name="TimedMinutesBox" Grid.Column="1" PlaceholderText="分钟" Minimum="1" Maximum="1440" Value="30" SpinButtonPlacementMode="Compact" />
                                    <Button Grid.Column="2" Content="添加" Click="AddTimedCategory_Click" />
                                </Grid>
                                <ListView x:Name="TimedCategoriesList" SelectionMode="Single" Height="360">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyTextBlockStyle}" Padding="0,6" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Content="删除所选类别" Click="DeleteTimedCategory_Click" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="限时网站" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TimedDomainBox" PlaceholderText="域名" />
                                    <ComboBox x:Name="TimedCategoryCombo" Grid.Column="1" PlaceholderText="类别" />
                                    <Button Grid.Column="2" Content="添加" Click="AddTimedRule_Click" />
                                </Grid>
                                <CheckBox x:Name="TimedSubdomainCheck" Content="包含子域名" />
                                <ListView x:Name="TimedRulesList" SelectionMode="Single" Height="320">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyTextBlockStyle}" Padding="0,6" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Content="删除所选网站" Click="DeleteTimedRule_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 分类管控 -->
                    <Grid x:Name="CategoriesPage" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="分类名单导入" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="只导入管理员审核过的 Markdown 名单；文件名与类别来自文件本身，程序不会编造域名。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CategoryPathBox" PlaceholderText="选择或粘贴 .md 名单路径" />
                                    <Button Grid.Column="1" Content="浏览…" Click="BrowseCategories_Click" />
                                    <Button Grid.Column="2" Content="导入" Click="ImportCategories_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="启用 / 停用所选类别" Click="ToggleCategory_Click" />
                                <TextBlock x:Name="CategoryHint" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="8">
                            <ListView x:Name="CategoriesList" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="160" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding StateBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SourceName}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- 访问日志 -->
                    <Grid x:Name="LogsPage" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="LogSearch" PlaceholderText="按主机名搜索" QueryIcon="Find" QuerySubmitted="LogSearch_QuerySubmitted" />
                                <CheckBox x:Name="BlockedOnlyCheck" Grid.Column="1" Content="仅拦截" VerticalAlignment="Center" Click="BlockedOnly_Click" />
                                <Button Grid.Column="2" Content="刷新" Click="RefreshLogs_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="8">
                            <ListView x:Name="LogsList" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Domain}" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Method}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding ResultText}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{Binding ResultBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- 策略历史 -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="策略版本历史" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="恢复历史版本会生成一个新版本，不会改写过去；历史记录不代表已认证的管理员操作。" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Button Content="恢复所选版本" Click="Restore_Click" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{ThemeResource OverlayCornerRadius}" Padding="8">
                            <ListView x:Name="HistoryList" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyTextBlockStyle}" Padding="8,6" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
