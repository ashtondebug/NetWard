<Window
    x:Class="NetWard.Modern.AdminDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NetWard 管理&#x7AEF; · Modern Demo">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F6F8FC" />
                <SolidColorBrush x:Key="SidebarBrush" Color="#EEF2F7" />
                <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="PanelAltBrush" Color="#EBF1FA" />
                <SolidColorBrush x:Key="BorderBrush" Color="#D5DDE8" />
                <SolidColorBrush x:Key="TextBrush" Color="#182334" />
                <SolidColorBrush x:Key="MutedBrush" Color="#58677D" />
                <SolidColorBrush x:Key="BlueBrush" Color="#2C61C3" />
                <SolidColorBrush x:Key="GreenBrush" Color="#087A55" />
                <SolidColorBrush x:Key="AmberBrush" Color="#935B00" />
                <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="SelectedBrush" Color="#DCE8FF" />
                <SolidColorBrush x:Key="HoverBrush" Color="#E8EEF7" />
                <SolidColorBrush x:Key="SubtleBrush" Color="#F6F8FC" />
                <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF4D9" />
                <SolidColorBrush x:Key="WarningBorderBrush" Color="#E5C97D" />
                <SolidColorBrush x:Key="C23314A" Color="#E5EBF5" />
                <SolidColorBrush x:Key="C24457D" Color="#DDE9FF" />
                <SolidColorBrush x:Key="C3267D5" Color="#3267D5" />
                <SolidColorBrush x:Key="C71819A" Color="#68778D" />
                <SolidColorBrush x:Key="C8090A7" Color="#6C798C" />
                <SolidColorBrush x:Key="CBBD0FF" Color="#214C91" />
                <SolidColorBrush x:Key="CBDD0FF" Color="#214C91" />
                <SolidColorBrush x:Key="CC5D4EF" Color="#345071" />
                <SolidColorBrush x:Key="CC5D5F5" Color="#214C91" />
                <SolidColorBrush x:Key="C171F2E" Color="#F1F4F8" />
                <SolidColorBrush x:Key="C202B3C" Color="#EFF2F6" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1020" />
                <SolidColorBrush x:Key="SidebarBrush" Color="#0E1626" />
                <SolidColorBrush x:Key="PanelBrush" Color="#121B2F" />
                <SolidColorBrush x:Key="PanelAltBrush" Color="#17233A" />
                <SolidColorBrush x:Key="BorderBrush" Color="#2A3850" />
                <SolidColorBrush x:Key="TextBrush" Color="#F3F6FB" />
                <SolidColorBrush x:Key="MutedBrush" Color="#A5B2C7" />
                <SolidColorBrush x:Key="BlueBrush" Color="#78A1FF" />
                <SolidColorBrush x:Key="GreenBrush" Color="#64D3A3" />
                <SolidColorBrush x:Key="AmberBrush" Color="#F2BD73" />
                <SolidColorBrush x:Key="HeaderBrush" Color="#101827" />
                <SolidColorBrush x:Key="SelectedBrush" Color="#1B2B4A" />
                <SolidColorBrush x:Key="HoverBrush" Color="#202B3C" />
                <SolidColorBrush x:Key="SubtleBrush" Color="#141E2E" />
                <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#252316" />
                <SolidColorBrush x:Key="WarningBorderBrush" Color="#5A4928" />
                <SolidColorBrush x:Key="C23314A" Color="#23314A" />
                <SolidColorBrush x:Key="C24457D" Color="#24457D" />
                <SolidColorBrush x:Key="C3267D5" Color="#3267D5" />
                <SolidColorBrush x:Key="C71819A" Color="#71819A" />
                <SolidColorBrush x:Key="C8090A7" Color="#8090A7" />
                <SolidColorBrush x:Key="CBBD0FF" Color="#BBD0FF" />
                <SolidColorBrush x:Key="CBDD0FF" Color="#BDD0FF" />
                <SolidColorBrush x:Key="CC5D4EF" Color="#C5D4EF" />
                <SolidColorBrush x:Key="CC5D5F5" Color="#C5D5F5" />
                <SolidColorBrush x:Key="C171F2E" Color="#171F2E" />
                <SolidColorBrush x:Key="C202B3C" Color="#202B3C" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1020" />
                <SolidColorBrush x:Key="SidebarBrush" Color="#0E1626" />
                <SolidColorBrush x:Key="PanelBrush" Color="#121B2F" />
                <SolidColorBrush x:Key="PanelAltBrush" Color="#17233A" />
                <SolidColorBrush x:Key="BorderBrush" Color="#2A3850" />
                <SolidColorBrush x:Key="TextBrush" Color="#F3F6FB" />
                <SolidColorBrush x:Key="MutedBrush" Color="#A5B2C7" />
                <SolidColorBrush x:Key="BlueBrush" Color="#78A1FF" />
                <SolidColorBrush x:Key="GreenBrush" Color="#64D3A3" />
                <SolidColorBrush x:Key="AmberBrush" Color="#F2BD73" />
                <SolidColorBrush x:Key="HeaderBrush" Color="#101827" />
                <SolidColorBrush x:Key="SelectedBrush" Color="#1B2B4A" />
                <SolidColorBrush x:Key="HoverBrush" Color="#202B3C" />
                <SolidColorBrush x:Key="SubtleBrush" Color="#141E2E" />
                <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#252316" />
                <SolidColorBrush x:Key="WarningBorderBrush" Color="#5A4928" />
                <SolidColorBrush x:Key="C23314A" Color="#23314A" />
                <SolidColorBrush x:Key="C24457D" Color="#24457D" />
                <SolidColorBrush x:Key="C3267D5" Color="#3267D5" />
                <SolidColorBrush x:Key="C71819A" Color="#71819A" />
                <SolidColorBrush x:Key="C8090A7" Color="#8090A7" />
                <SolidColorBrush x:Key="CBBD0FF" Color="#BBD0FF" />
                <SolidColorBrush x:Key="CBDD0FF" Color="#BDD0FF" />
                <SolidColorBrush x:Key="CC5D4EF" Color="#C5D4EF" />
                <SolidColorBrush x:Key="CC5D5F5" Color="#C5D5F5" />
                <SolidColorBrush x:Key="C171F2E" Color="#171F2E" />
                <SolidColorBrush x:Key="C202B3C" Color="#202B3C" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource HoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SelectedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SelectedBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BlueBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SelectedBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BlueBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SelectedBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BlueBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Padding="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource C3267D5}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{ThemeResource AppBackgroundBrush}" />
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{ThemeResource HeaderBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource C24457D}">
                        <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource CBBD0FF}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NetWard" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock Text="管理&#x7AEF; · Modern Demo" FontSize="10" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Margin="0,0,12,0" Padding="10,6" CornerRadius="6" Background="{ThemeResource WarningSurfaceBrush}" BorderBrush="{ThemeResource WarningBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="仅为界面演示" FontSize="11" Foreground="{ThemeResource AmberBrush}" />
                </Border>
                <Button x:Name="ThemeButton" Grid.Column="2" Content="主题：跟随系&#x7EDF;" Margin="0,0,16,0"
                        Padding="10,7" Background="Transparent" Foreground="{ThemeResource TextBrush}"
                        BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                        Click="ThemeButton_Click" />
                <Border Grid.Column="3" Width="34" Height="34" CornerRadius="17" Background="{ThemeResource C23314A}" VerticalAlignment="Center">
                    <TextBlock Text="AD" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource CC5D4EF}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="5,12,5,0">
                    <TextBlock Text="WORKSPACE" FontSize="10" CharacterSpacing="110" Foreground="{ThemeResource C71819A}" />
                    <TextBlock Text="本机演示空间" Margin="0,7,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="4">
                    <ToggleButton x:Name="OverviewNav" Tag="overview" IsChecked="True" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="16" /><TextBlock Text="总览" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DevicesNav" Tag="devices" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="16" /><TextBlock Text="设备管理" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="RulesNav" Tag="rules" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8D7;" FontSize="16" /><TextBlock Text="访问策略" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LogsNav" Tag="logs" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D9;" FontSize="16" /><TextBlock Text="事件记录" VerticalAlignment="Center" /></StackPanel>
                    </ToggleButton>
                </StackPanel>
                <Border Grid.Row="4" Padding="12" CornerRadius="9" Background="{ThemeResource SubtleBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="演示边界" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                        <TextBlock Text="不连接设备、不发送策略，也不拦截网络请求&#x3002;" TextWrapping="Wrap" FontSize="10" LineHeight="16" Foreground="{ThemeResource MutedBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Padding="30,25,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="管理总览" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                    <TextBlock x:Name="PageSubtitle" Text="演示状&#x6001; · 示例数据，不代表实际设备或审计记&#x5F55;" Margin="0,5,0,0" FontSize="12" Foreground="{ThemeResource MutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="演示说明" Click="About_Click" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="DemoInfo" Grid.Row="1" Visibility="Visible" Background="{ThemeResource PanelAltBrush}"
                    BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DemoInfoTitle" Text="演示环境" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource BlueBrush}" />
                    <TextBlock x:Name="DemoInfoMessage" Text="以下设备、策略和事件均为本地示例数据；没有远程连接、真实日志或网络过滤&#x3002;"
                               TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid x:Name="OverviewPage">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="18">
                                    <StackPanel Spacing="9"><TextBlock Text="已登记设&#x5907;" FontSize="12" Foreground="{ThemeResource MutedBrush}" /><TextBlock Text="03" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="示例数量 · 非在线数&#x636E;" FontSize="10" Foreground="{ThemeResource C8090A7}" /></StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18">
                                    <StackPanel Spacing="9"><TextBlock Text="待处理申&#x8BF7;" FontSize="12" Foreground="{ThemeResource MutedBrush}" /><TextBlock Text="02" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource AmberBrush}" /><TextBlock Text="静态示&#x610F; · 不会产生通知" FontSize="10" Foreground="{ThemeResource C8090A7}" /></StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18">
                                    <StackPanel Spacing="9"><TextBlock Text="策略同步" FontSize="12" Foreground="{ThemeResource MutedBrush}" /><TextBlock Text="未连&#x63A5;" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource MutedBrush}" /><TextBlock Text="配对与同步尚未实&#x73B0;" FontSize="10" Foreground="{ThemeResource C8090A7}" /></StackPanel>
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="18">
                                    <StackPanel Spacing="13">
                                        <Grid><TextBlock Text="设备状态示&#x610F;" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="演示数据" HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource AmberBrush}" /></Grid>
                                        <Grid ColumnSpacing="8" Padding="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBlock Text="设备名称" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="1" Text="状&#x6001;" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="2" Text="当前策略" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></Grid>
                                        <Border Height="1" Background="{ThemeResource BorderBrush}" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CLASSROOM-PC-01" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="设备示例 · ID DEMO-001" Margin="0,4,0,0" FontSize="9" Foreground="{ThemeResource C8090A7}" /></StackPanel><TextBlock Grid.Column="1" Text="示例在线" FontSize="10" Foreground="{ThemeResource GreenBrush}" /><TextBlock Grid.Column="2" Text="教学白名&#x5355;" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></Grid>
                                        <Border Height="1" Background="{ThemeResource BorderBrush}" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LIBRARY-PC-02" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="设备示例 · ID DEMO-002" Margin="0,4,0,0" FontSize="9" Foreground="{ThemeResource C8090A7}" /></StackPanel><TextBlock Grid.Column="1" Text="示例离线" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="2" Text="未同&#x6B65;" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="策略摘要" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                                        <Border Padding="12" CornerRadius="8" Background="{ThemeResource PanelAltBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="白名单模&#x5F0F;" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource CBDD0FF}" /><TextBlock Text="命中规则允许；未命中默认拒绝&#x3002;" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></StackPanel></Border>
                                        <Border Padding="12" CornerRadius="8" Background="{ThemeResource C171F2E}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock Text="分类管控" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="此演示不加载网站分类数据&#x3002;" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></StackPanel></Border>
                                        <Button Content="查看策略演示" Tag="rules" Click="Navigate_Click" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PanelStyle}" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid><TextBlock Text="最近事&#x4EF6; · 示例" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="非真实访问日&#x5FD7;" HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource AmberBrush}" /></Grid>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="时间（示例）" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="1" Text="目标主机" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="2" Text="结果" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></Grid>
                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="2026-10-30 09:14" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="1" Text="portal.example.test" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextBrush}" /><TextBlock Grid.Column="2" Text="示例允许" FontSize="10" Foreground="{ThemeResource GreenBrush}" /></Grid>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="2026-10-30 09:12" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="1" Text="media.example.test" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextBrush}" /><TextBlock Grid.Column="2" Text="示例拒绝" FontSize="10" Foreground="{ThemeResource AmberBrush}" /></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DevicesPage" Visibility="Collapsed">
                        <StackPanel Spacing="16">
                            <Border Style="{StaticResource PanelStyle}" Padding="22">
                                <StackPanel Spacing="10"><TextBlock Text="设备管理演示" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="以下设备条目是静态示意数据。真实配对、心跳、IP 采集和策略同步尚未实现&#x3002;" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource MutedBrush}" /><Button Content="添加设备（未实现&#x73B0;" Click="Unimplemented_Click" Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,0" /></StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Padding="20">
                                <StackPanel Spacing="15">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><TextBlock Text="设备" FontSize="11" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="1" Text="连接" FontSize="11" Foreground="{ThemeResource MutedBrush}" /><TextBlock Grid.Column="2" Text="版本" FontSize="11" Foreground="{ThemeResource MutedBrush}" /></Grid>
                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CLASSROOM-PC-01" FontFamily="Consolas" Foreground="{ThemeResource TextBrush}" /><TextBlock Text="DEMO-001 · 示例标识" Margin="0,4,0,0" FontSize="10" Foreground="{ThemeResource MutedBrush}" /></StackPanel><TextBlock Grid.Column="1" Text="模拟状&#x6001;" Foreground="{ThemeResource GreenBrush}" /><TextBlock Grid.Column="2" Text="Agent Modern Demo" Foreground="{ThemeResource MutedBrush}" /></Grid>
                                    <Border Height="1" Background="{ThemeResource BorderBrush}" />
