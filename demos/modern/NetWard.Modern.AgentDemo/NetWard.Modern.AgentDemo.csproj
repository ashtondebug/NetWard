<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsSdkPackageVersion>10.0.26100.56</WindowsSdkPackageVersion>
    <RootNamespace>NetWard.Modern.AgentDemo</RootNamespace>
    <AssemblyName>NetWard.Modern.AgentDemo</AssemblyName>
    <ApplicationTitle>NetWard 被控端 Modern Demo</ApplicationTitle>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>
  <Target Name="CopyWinUIResourceIndexToPublish" AfterTargets="Publish">
    <Error Condition="!Exists('$(OutDir)$(AssemblyName).pri')" Text="The WinUI resource index $(AssemblyName).pri was not generated." />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
